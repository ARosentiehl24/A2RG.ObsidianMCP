# Absolute path to the vault used by the direct filesystem fallback.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Plugin bridge. This address must stay on the local machine.
OBSIDIAN_API_URL=https://127.0.0.1:27125

# Copy the bearer token generated in Obsidian plugin settings.
OBSIDIAN_API_KEY=replace-with-the-plugin-bearer-token

# Prefer the plugin bridge, then fall back to the filesystem.
OBSIDIAN_PREFER_REST=true
OBSIDIAN_TIMEOUT_MS=3000

# Absolute path to the Obsidian configuration directory.
# Use .obsidian for the normal layout or your custom config folder path.
OBSIDIAN_CONFIG_DIR=/absolute/path/to/your/vault/.obsidian

# HTTPS only: path to the local self-signed certificate used as the CA.
# Example: /home/a2rg/.config/obsidian/a2rg-mcp-bridge/tls/localhost.pem
OBSIDIAN_CA_CERT=
